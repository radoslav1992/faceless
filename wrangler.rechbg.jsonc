{
  // Реч БГ: the second site built from this code (docs/SITES.md). It deploys into the Worker the earlier Реч БГ app
  // ran in (rech-bg), so that Worker's variables and secrets (Stripe, fal, ElevenLabs, HeyGen, Turnstile, the company's
  // details, the switches) are the new site's too: Cloudflare cannot copy a secret to another Worker. Its database,
  // bucket and workflows are new and its own; nothing is shared with Hookstreak (wrangler.jsonc).
  //   npm run deploy:rechbg   (or GitHub → Actions → Deploy Реч БГ)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rech-bg",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker's half of the site switch (shared/site.ts): Bulgarian, euro, Реч БГ's name. The app's half is
  // SITE=rechbg in the build (vite.config.ts).
  "define": { "__SITE__": "\"rechbg\"" },
  // Dashboard variables and secrets survive deploys.
  "keep_vars": true,
  // What the earlier app had as defaults in its code and this one reads from its settings. Sign-ups and payments
  // need all three. rechbg.com has Email Sending set up in Cloudflare.
  "vars": {
    "SITE_URL": "https://rechbg.com",
    "CONTACT_EMAIL": "info@rechbg.com",
    "COMPANY_NAME": "Радослав Додников (Кова студио)",
  },
  // The site's addresses. mashinazaistorii.com is its new one (the site is „Машина за истории“ since 2026-11-21);
  // rechbg.com, the earlier one, stays until SITE_URL moves to the new address, and redirects there after that.
  "routes": [{ "pattern": "rechbg.com", "custom_domain": true }, { "pattern": "mashinazaistorii.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist-rechbg",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "ai": { "binding": "AI" },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["info@rechbg.com"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rechbg",
      // Реч БГ's own database (Western Europe), created empty on 2026-11-18. The deploy applies the migrations.
      "database_id": "1124cf5a-4c90-4a18-9c31-552a2fe8a689",
      "migrations_dir": "migrations",
    },
    { "binding": "HOOKSTREAK_DB", "database_name": "faceless", "database_id": "09be5383-f865-4b98-8739-3b368568cbcd" },
  ],
  // Реч БГ's own bucket, created empty on 2026-11-18. The second one is Hookstreak's, with its database above: bound
  // so the maintenance can copy Hookstreak's library into Реч БГ's own (server/library-import.ts). They are only read.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "rechbg-media" },
    { "binding": "HOOKSTREAK_MEDIA", "bucket_name": "faceless-media" },
  ],
  // Three renderers, each running one job at a time (server/renderer.ts).
  "containers": [
    { "class_name": "MediaRenderer", "image": "./renderer/Dockerfile", "max_instances": 3, "instance_type": "standard-2" },
  ],
  "durable_objects": { "bindings": [{ "name": "MEDIA_RENDERER", "class_name": "MediaRenderer" }] },
  // The renderer class of this Worker exists since the earlier app, under this tag: the same entry, so no new migration runs.
  "migrations": [{ "tag": "media-v1", "new_sqlite_classes": ["MediaRenderer"] }],
  "workflows": [
    { "name": "rechbg-content", "binding": "CONTENT", "class_name": "ContentGeneration" },
    { "name": "rechbg-publish", "binding": "PUBLISH", "class_name": "Publication" },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 120000 },
}
