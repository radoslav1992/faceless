{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faceless",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Dashboard variables and secrets survive GitHub deploys.
  "keep_vars": true,
  // Public settings tied to the domain, set on every deploy (a dashboard value for these names is replaced).
  // Switches, secrets and anything private (ADMIN_EMAILS) stay in the dashboard. See docs/DEPLOYMENT.md.
  "vars": {
    "SITE_URL": "https://hookstreak.app",
    // hookstreak.app has Email Sending (and Email Routing for replies) set up in Cloudflare.
    "CONTACT_EMAIL": "hello@hookstreak.app",
  },
  // hookstreak.app is the public address; www redirects there (canonicalUrl in server/config.ts). Both were custom
  // domains of the ad-app Worker (hookstreak.com): deploy ad-app without them first, a domain belongs to one Worker.
  "routes": [
    { "pattern": "hookstreak.app", "custom_domain": true },
    { "pattern": "www.hookstreak.app", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "ai": { "binding": "AI" },
  // hello@hookstreak.com stays allowed while a dashboard EMAIL_FROM may still name it.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hello@hookstreak.app", "hello@hookstreak.com"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "faceless",
      // The production database (Western Europe), created 2026-10-10 with 0001_initial.sql applied.
      "database_id": "09be5383-f865-4b98-8739-3b368568cbcd",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "faceless-media" }],
  // Three renderers and one container that only downloads YouTube videos (imports from people's own channels).
  "containers": [
    { "class_name": "MediaRenderer", "image": "./renderer/Dockerfile", "max_instances": 4, "instance_type": "standard-2" },
  ],
  "durable_objects": { "bindings": [{ "name": "MEDIA_RENDERER", "class_name": "MediaRenderer" }] },
  "migrations": [{ "tag": "renderer-v1", "new_sqlite_classes": ["MediaRenderer"] }],
  "workflows": [
    { "name": "faceless-content", "binding": "CONTENT", "class_name": "ContentGeneration" },
    { "name": "faceless-publish", "binding": "PUBLISH", "class_name": "Publication" },
  ],
  // Every minute: due videos are published and series get their next episodes. Heavier maintenance runs once an hour
  // inside the same handler.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 120000 },
}
